# Copy to backend/.env (git-ignored). Everything here is optional for local development.

# TMDB credentials — https://developer.themoviedb.org/docs/getting-started
# Prefer the v4 "API Read Access Token"; a v3 API key also works. Without either,
# ReelTime uses its built-in fictional sample catalog.
TMDB_API_TOKEN=
# TMDB_API_KEY=

# Postgres connection, if not using the local socket defaults.
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=

# Production only
# REELTIME_DATABASE_PASSWORD=
# RAILS_MASTER_KEY=
